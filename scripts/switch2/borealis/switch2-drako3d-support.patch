diff --git a/library/cmake/toolchain.cmake b/library/cmake/toolchain.cmake
index 3cb069b..a45d638 100644
--- a/library/cmake/toolchain.cmake
+++ b/library/cmake/toolchain.cmake
@@ -76,6 +76,21 @@ elseif(PLATFORM_PS4)
     set(OPENORBIS $ENV{OPENORBIS} CACHE BOOL "OPENORBIS")
     set(CMAKE_TOOLCHAIN_FILE "${OPENORBIS}/cmake/ps4.cmake" CACHE PATH "toolchain file")
     add_definitions(-DPS4 -D__PS4__)
+elseif (PLATFORM_SWITCH2)
+    message(STATUS "building for SWITCH2")
+    if (NOT DEFINED ENV{DEVKITPRO})
+        message(FATAL_ERROR "Please set DEVKITPRO in your environment. export DEVKITPRO=<path to>/devkitpro")
+    endif ()
+    set(DEVKITPRO $ENV{DEVKITPRO} CACHE BOOL "DEVKITPRO")
+    set(CMAKE_C_FLAGS "-D__SWITCH__ -D__SWITCH2__ -I${DEVKITPRO}/libounce/include -I${DEVKITPRO}/portlibs/switch2/include -I${DEVKITPRO}/portlibs/switch/include")
+    set(CMAKE_CXX_FLAGS "${CMAKE_C_FLAGS}")
+    # NOTE: do NOT include devkitPro's Switch.cmake here. The Switch 2
+    # toolchain file (libounce Switch2.cmake) is already active via
+    # aarch64-none-elf-cmake; Switch.cmake would reset NX_ROOT and
+    # PKG_CONFIG_EXECUTABLE to Switch 1 (libnx) locations.
+    if (NOT USE_GLFW AND NOT SDL2)
+        set(USE_GLFW ON)
+    endif ()
 elseif (PLATFORM_SWITCH)
     message(STATUS "building for SWITCH")
     if (NOT DEFINED ENV{DEVKITPRO})
@@ -89,11 +104,16 @@ elseif (PLATFORM_SWITCH)
         set(USE_GLFW ON)
     endif ()
 else()
-    message(FATAL_ERROR "Please set build target. Example: -DPLATFORM_DESKTOP=ON or -DPLATFORM_SWITCH=ON")
+    message(FATAL_ERROR "Please set build target. Example: -DPLATFORM_DESKTOP=ON, -DPLATFORM_SWITCH=ON or -DPLATFORM_SWITCH2=ON")
 endif ()
 
 # graphics drivers
-if (USE_DEKO3D)
+if (USE_DRAKO3D)
+    message(STATUS "USE_DRAKO3D")
+    # drako3d is API-compatible with deko3d; reuse the deko3d code path
+    # (nanovg-dk) compiled against drako3d headers via deko3d-compat shims.
+    set(BOREALIS_USE_DEKO3D ON)
+elseif (USE_DEKO3D)
     message(STATUS "USE_DEKO3D")
     set(BOREALIS_USE_DEKO3D ON)
 elseif (USE_D3D11)
