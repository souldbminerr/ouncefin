+                { crx, cty, 1.5f * NVG_PI, 2.0f * NVG_PI, 0.25f }, // top-right
+                { crx, cby, 0.0f, 0.5f * NVG_PI, 0.50f }, // bottom-right
+                { clx, cby, 0.5f * NVG_PI, NVG_PI, 0.75f }, // bottom-left
+            };
+            for (const auto& c : corners)
