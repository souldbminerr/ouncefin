+
+void SwitchInputManager::handlePadPointer()
+{
+    if (!this->padMouseReady)
+        return;
+
+    const Time now = getCPUTimeUsec();
+
+    // Fresh per-frame movement; position persists from the last sample.
+    // The stick doubles as the Nmouse wheel source, but sticks are pure
+    // gamepad navigation: the merged wheel is always ignored so it can
+    // never leak into the mouse layer (that would flash the cursor and
+    // flip the input type on every stick push). Mouse-mode scrolling is
+    // done by dragging, like touch; USB mice keep their own wheel path.
+    this->padMouseDeltaX = 0;
+    this->padMouseDeltaY = 0;
+    this->padMouseWheel  = 0;
+
+    // Clicks come straight from the pads (L/R = left, ZL/ZR = right),
+    // which is always live, unlike service samples. Adopt buttons held when mouse
+    // mode engages so a resting finger never fires a phantom click; a
+    // release drops them from the adopt mask so the next press counts.
+    const uint64_t padButtons = this->pollPadButtons();
+    this->padMousePadButtons = padButtons;
+    // Releases always drop out of the adopt mask (mode or not), so a stale
+    // mask can never swallow a future press.
+    this->padMouseAdoptButtons &= padButtons & PAD_MOUSE_CLICK_MASK;
+    const uint64_t freshButtons = padButtons & ~this->padMouseAdoptButtons;
+    const bool padLeft  = (freshButtons & ((uint64_t)HidNpadButton_L | (uint64_t)HidNpadButton_R)) != 0;
+    const bool padRight = (freshButtons & ((uint64_t)HidNpadButton_ZL | (uint64_t)HidNpadButton_ZR)) != 0;
+
+    HidNmouseHandle handle{};
+    if (R_SUCCEEDED(hidGetMergedNmouseHandle(&handle)))
+    {
+        HidNmouseStateWithDelta states[16];
+        size_t count = 0;
+        if (R_SUCCEEDED(hidGetNmouseStatesWithDelta(handle, states, 16, &count)) && count > 0)
+        {
+            const bool fresh = !this->padMouseFound || this->padMouseHandle.handle != handle.handle;
+            this->padMouseFound   = true;
+            this->padMouseHandle  = handle;
+            this->padMouseX       = states[0].x;
+            this->padMouseY       = states[0].y;
+            this->padMouseFlags   = states[0].flags;
+            if (!fresh)
+            {
+                for (size_t i = 0; i < count && states[i].sampling_number > this->padMouseSeen; i++)
+                {
+                    this->padMouseDeltaX += states[i].delta_x;
+                    this->padMouseDeltaY += states[i].delta_y;
+                }
+            }
+            this->padMouseSeen = states[0].sampling_number;
+            if (!this->padMouseLogged)
+            {
+                this->padMouseLogged = true;
+                Logger::info("PadMouse: Joy-Con mouse active");
+            }
+        }
+        else
+        {
+            // Pointer exists but produced no samples: clicks below still
+            // register; only the idle timeout applies otherwise.
+            this->padMouseFound  = true;
+            this->padMouseHandle = handle;
+        }
+    }
+    else
+    {
+        // No Joy-Con mouse right now. A held click still counts if the
+        // pointer was in use very recently (service handle flap), so a
+        // press is never swallowed; otherwise hand back to the controller.
+        this->padMouseFound     = false;
+        this->padMouseHasAnchor = false;
+        if (padLeft || padRight)
+        {
+            if (now - this->padMouseLastActive < PAD_MOUSE_IDLE_HIDE_USEC)
+            {
+                this->padMouseMode       = true;
+                this->padMouseLastActive = now;
+            }
+        }
+        else if (this->padMouseMode && now - this->padMouseLastActive >= PAD_MOUSE_IDLE_HIDE_USEC)
+            this->padMouseMode = false;
+        this->padMouseLeftDown  = padLeft;
+        this->padMouseRightDown = padRight;
+        return;
+    }
+
+    if (!this->padMouseHasAnchor)
+    {
+        this->padMouseAnchorX   = this->padMouseX;
+        this->padMouseAnchorY   = this->padMouseY;
+        this->padMouseHasAnchor = true;
+    }
+
+    // Movement only counts while the sensor tracks the surface (flags bit
+    // 1); a huge jump engages regardless, in case the bit is unavailable.
+    const int dx       = this->padMouseX - this->padMouseAnchorX;
+    const int dy       = this->padMouseY - this->padMouseAnchorY;
+    const int distSq   = dx * dx + dy * dy;
+    const bool tracked = (this->padMouseFlags & 0x2u) != 0;
+    const bool moved   = (tracked && distSq >= (PAD_MOUSE_MOVE_THRESHOLD * PAD_MOUSE_MOVE_THRESHOLD))
+        || distSq >= (PAD_MOUSE_TRACKLESS_JUMP * PAD_MOUSE_TRACKLESS_JUMP);
+    const bool clicked = padLeft || padRight;
+    // The stick is the Joy-Con wheel source and sticks are pure gamepad
+    // navigation, so the merged wheel never reaches the mouse layer.
+    // (Mouse-mode list scrolling is done by dragging, like touch; USB
+    // mice keep their own separate wheel path.)
+    const bool scrolled = false;
