+#ifdef __SWITCH2__
+/*
+ * Switch 2 (T239/Ampere) has no on-device shader compiler: libuam emits
+ * the Maxwell microcode the Ampere GPU rejects. Compiled DKSH code is
+ * produced offline with uam2 and served here as dk_shadercache blobs
+ * (the same format save_shader_code/load_shader_code exchange through
+ * vo_gpu's cached_program), keyed by an FNV-1a hash of the GLSL
+ * sources. On a miss the requested sources are dumped to SD so they
+ * can be compiled offline; see switchfin/scripts/switch2/mpv/.
+ */
+#define DK_SHADER_ROMFS "romfs:/mpv-shaders"
+#define DK_SHADER_DIR  "sdmc:/switch/Switchfin/shaders"
+#define DK_SHADER_DUMP "sdmc:/switch/Switchfin/shader-dump"
+
+static uint64_t dk_shader_hash(const char *a, const char *b) {
+    const uint64_t prime = 0x100000001b3ULL;
+    uint64_t h = 0xcbf29ce484222325ULL;
+    for (int i = 0; i < 2; i++) {
+        for (const char *p = i ? b : a; p && *p; p++) {
+            h ^= (uint8_t)*p;
+            h *= prime;
+        }
+        h ^= 0xff;
+        h *= prime;
+    }
+    return h;
+}
+
+static void dk_shader_write_file(const char *dir, uint64_t hash, const char *stage, const char *src) {
+    char path[256];
+    snprintf(path, sizeof(path), "%s/%016" PRIx64 ".%s.glsl", dir, hash, stage);
+    FILE *f = fopen(path, "wb");
+    if (!f)
+        return;
+    fwrite(src, 1, strlen(src), f);
+    fclose(f);
+}
+
+/* Dump the GLSL of a compile request that could not be served from the
+ * precompiled set. The renderpass fails; feed the dumps through uam2
+ * and copy the resulting blobs into DK_SHADER_DIR to complete the set. */
+static void dk_shader_dump(struct ra *ra, uint64_t hash,
+                           const char *vert, const char *frag, const char *comp) {
+    mkdir(DK_SHADER_DUMP, 0777);
+    if (vert) dk_shader_write_file(DK_SHADER_DUMP, hash, "vert", vert);
+    if (frag) dk_shader_write_file(DK_SHADER_DUMP, hash, "frag", frag);
+    if (comp) dk_shader_write_file(DK_SHADER_DUMP, hash, "comp", comp);
+    MP_ERR(ra, "deko3d: no precompiled shader %016" PRIx64
+               ", dumped GLSL to %s (compile with uam2, copy blobs to %s)\n",
+           hash, DK_SHADER_DUMP, DK_SHADER_DIR);
+}
+
+/* Load a precompiled dk_shadercache blob for this hash, if present.
+ * Shipped (romfs) blobs are tried first; the SD directory is the
+ * developer's override/extension path. */
+static bool dk_shader_load_blob(void *ta_parent, uint64_t hash, bstr *out) {
+    static const char *dirs[] = { DK_SHADER_ROMFS, DK_SHADER_DIR };
+    for (size_t i = 0; i < sizeof(dirs) / sizeof(dirs[0]); i++) {
+        char path[256];
+        snprintf(path, sizeof(path), "%s/%016" PRIx64 ".bin", dirs[i], hash);
+        FILE *f = fopen(path, "rb");
+        if (!f)
+            continue;
+        bool ok = false;
+        fseek(f, 0, SEEK_END);
+        long size = ftell(f);
+        rewind(f);
+        if (size > (long)sizeof(struct dk_shadercache_hdr)) {
+            char *buf = ta_zalloc_size(ta_parent, size);
+            if (buf && fread(buf, 1, size, f) == (size_t)size) {
+                *out = (bstr){buf, size};
+                ok = true;
+            } else {
+                talloc_free(buf);
+            }
+        }
+        fclose(f);
+        if (ok)
+            return true;
+    }
+    return false;
+}
+#endif
